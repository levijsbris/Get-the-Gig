{
  "name": "portfoliopro",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Multi-tenant portfolio builder monorepo",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r run typecheck",
    "dev:editor": "pnpm --filter @portfoliopro/editor dev",
    "dev:viewer": "pnpm --filter @portfoliopro/viewer dev",
    "emulators:up": "docker compose up -d",
    "emulators:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^20.17.16",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0"
  }
}
