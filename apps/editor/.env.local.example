# Editor app local env. Copy to .env.local and adjust if needed.
# Local dev: connect to the docker-compose emulators.
VITE_FIREBASE_PROJECT_ID=portfoliopro-local
VITE_FIREBASE_AUTH_EMULATOR_HOST=http://localhost:9099
# The editor talks to the backend via Vite's dev-server proxy ("/api"
# rewrites to localhost:5080 in vite.config.ts), so VITE_API_BASE_URL
# only needs to be set for non-default deployments.
