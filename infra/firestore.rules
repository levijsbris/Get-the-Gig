rules_version = '2';

// Phase 2 — adds /users/{uid}/portfolioSlugs/{slug} for transactional slug uniqueness.
// Subtrees for assets/viewerPasswords still aren't reachable from any endpoint;
// they're declared so Phase 3+ can land without rule churn.
service cloud.firestore {
  match /databases/{database}/documents {

    // Per-user subtree — only the owner can touch it.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid;
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid;
      // Hard delete only via backend Admin SDK (bypasses rules); clients soft-delete
      // through /api/auth/account.
      allow delete: if false;

      match /portfolios/{pid} {
        allow read, write: if request.auth != null && request.auth.uid == uid;

        match /viewerPasswords/{pwid} {
          allow read, write: if request.auth != null && request.auth.uid == uid;
        }
      }

      // Per-user slug index. The owner can read (for the future "show all my slugs"
      // diagnostics view) but cannot write — the slug doc and the portfolio doc must
      // be created and renamed inside the same Firestore transaction, which only the
      // backend's Admin SDK can do.
      match /portfolioSlugs/{slug} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }

      match /assets/{aid} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Public read so the signup form can check availability; server-side only writes.
    match /usernames/{username} {
      allow read: if true;
      allow write: if false;
    }

    // Public viewer lookup index — public read, server-side only writes.
    match /portfolioRoutes/{routeId} {
      allow read: if true;
      allow write: if false;

      match /attempts/{ipBucket} {
        allow read, write: if false;
      }
    }

    // Curated templates — public read, seeded out-of-band by tools/seed-templates.
    match /templates/{templateId} {
      allow read: if true;
      allow write: if false;
    }

    // Backend-only collections.
    match /deletionQueue/{taskId} {
      allow read, write: if false;
    }
  }
}
